// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Notice > renders a title above the message 1`] = `
<DocumentFragment>
  <article
    class="no-elevate notice tertiary-container"
  >
    <i
      aria-hidden="true"
    >
      warning
    </i>
    <div
      class="max"
    >
      <div
        class="headline"
      >
        No recovery
      </div>
      <div>
        There is no password reset.
      </div>
    </div>
  </article>
</DocumentFragment>
`;

